    "@nera-static/plugin-navigation": "^3.1.1",
    "@nera-static/plugin-page-pagination": "^2.4.0",
    "@nera-static/plugin-search": "^2.3.0",
    "@nera-static/plugin-stacks": "^2.4.0",
