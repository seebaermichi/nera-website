{
  "name": "nera-website",
  "version": "1.0.0",
  "description": "Official website, documentation and tutorials for the Nera static site generator",
  "main": "index.js",
  "scripts": {
    "start": "nodemon",
    "serve": "vite",
    "lint": "eslint .",
    "render": "node index.js",
    "preserve": "npm run render",
    "watch:assets": "node src/watch-assets.js",
    "test": "vitest",
    "dev": "npm run render && concurrently -k -n 'vite,watch,server' -c blue,magenta,green \"npm:serve\" \"npm:watch:assets\" \"npm:start\"",
    "prepare": "husky"
  },
  "type": "module",
  "keywords": [
    "static-site-generator",
    "markdown",
    "pug",
    "jamstack",
    "blog",
    "documentation",
    "website",
    "ssg"
  ],
  "author": "Michael Becker <micha.becker79@gmail.com> (https://github.com/seebaermichi)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nera-static/plugin-canonical-links": "^2.2.0",
    "@nera-static/plugin-link-attributes": "^2.1.0",
    "@nera-static/plugin-navigation": "^2.3.0",
    "@nera-static/plugin-page-pagination": "^2.3.0",
    "@nera-static/plugin-search": "^1.2.0",
    "@nera-static/plugin-tags": "^3.1.0",
    "cpy": "^13.2.2",
    "fs-readdir-recursive": "^1.1.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-meta": "^0.0.1",
    "pretty": "^2.0.0",
    "pug": "^3.0.2",
    "rimraf": "^6.0.1",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.3",
    "dotenv": "^17.2.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "nodemon": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "nera": {
    "version": "4.4.0"
  }
}
