each item, index in elements || app.nav.elements
  - const isActive = item.href === meta.fullPath
  - const activeClass = isActive ? 'nav__link--active' : ''
  //- The site root, per language: '/' for en, '/de' and '/es' for the others
  //- (langPrefix comes from layout.pug). A page sitting directly in the root
  //- has no parent section, so nothing may be marked as its ancestor.
  //- Checking only against '/' — as the upstream template does — treats /de
  //- and /es as ordinary sections, and since every nav href in a language
  //- starts with that prefix, the test below then matched all of them.
  - const rootDir = langPrefix || '/'
  - const isNotHome = meta.dirname !== rootDir
  - const isParent = isNotHome && item.href.indexOf(meta.dirname) === 0
  - const activePathClass = !isActive && isParent ? 'nav__link--active-path' : ''
