-
    // `app.tagsConfig` is provided by getAppData, but a layout that renders
    // this template outside a tag page has no reason to have it. Reading
    // through it unguarded used to fail the whole build.
    const tagsConfig = app.tagsConfig || {}
    const taggedPages = meta.taggedPages || []
    // Keyed on the slug, with the raw tag name accepted as a fallback so a
    // config written before slugs existed keeps working for single-word tags.
    const tagImage = tagsConfig[`tag_overview_${ meta.tagSlug }_image`] || tagsConfig[`tag_overview_${ meta.tag }_image`] || tagsConfig.tag_overview_default_image

section.tag-overview
    header.tag-overview__header
        //- One heading, so the accessible name is the whole phrase
        //- ("advanced tutorials") rather than a bare tag.
        //-
        //- The wording comes from a pattern with a {tag} slot rather than a
        //- bare noun, because word order is not the same in every language:
        //- English and German put the tag first, Spanish puts the noun first
        //- ("tutoriales advanced"). Keeping the order in the translation means
        //- a new language is a config entry, not a branch in here.
        //-
        //- If the pattern is missing, t() hands back the key itself, which has
        //- no slot — render the tag alone rather than printing the key.
        -
            const headingPattern = t('tag_overview_heading')
            const headingParts = headingPattern.includes('{tag}') ? headingPattern.split('{tag}') : ['', '']
            const headingBefore = headingParts[0].trim()
            const headingAfter = (headingParts[1] || '').trim()
        h1.tag-overview__heading
            if headingBefore
                span.tag-overview__kind #{ headingBefore }
            span.tag-overview__title #{ meta.title }
            if headingAfter
                span.tag-overview__kind #{ headingAfter }

        if tagImage
            img.tag-overview__image(src=`${ tagImage }` alt='')

    if taggedPages.length > 0
        section.tag-overview__content
            each page in taggedPages
                article.tag-overview__item
                    h2.tag-overview__item-title #{ page.meta.title }

                    if page.meta.createdAt
                        time.tag-overview__item-date #{ new Date(page.meta.createdAt).toLocaleString(app.lang) }

                    p.tag-overview__item-description #{ page.meta.description }

                    //- Upstream hardcodes this in English. Now that overviews are
                    //- generated per language, that showed on every German and
                    //- Spanish tag page.
                    a.tag-overview__item-link(href=`${ page.meta.href }`) #{ t('tag_overview_read_more') }
