include ../vendor/plugin-navigation/partials/link-list-navigation

//- curLang comes from layout.pug (shared scope).
- const footerNav = app.nav['footer' + (curLang === 'en' ? '' : '_' + curLang)]

footer.site-footer
  .container
    .site-footer__inner
      .site-footer__brand
        span.site-footer__name
          svg.site-footer__logo(viewBox="0 0 32 32", width="18", height="18", aria-hidden="true", focusable="false")
            rect(x="7", y="4", width="8", height="12", fill="currentColor")
            rect(x="15", y="16", width="10", height="12", fill="currentColor")
          | #{ app.name }
        p.site-footer__tagline #{ t('tagline') }

      .site-footer__nav
        if footerNav
          nav.nav--footer(aria-label=t('footer_col_site'))
            p.site-footer__nav-heading #{ t('footer_col_site') }
            +linkListNav(footerNav.elements, '', langPrefix || '/')
        nav.nav--footer(aria-label=t('footer_col_project'))
          p.site-footer__nav-heading #{ t('footer_col_project') }
          ul.nav.nav--list
            li.nav__item
              a.nav__link(href=app.repo_url, target="_blank", rel="noopener noreferrer") GitHub
            li.nav__item
              a.nav__link(href=app.npm_org_url, target="_blank", rel="noopener noreferrer") npm

    p.site-footer__meta
      span MIT
      span
        | #{ t('footer_built_with') } ·
        |
        a(href=app.repo_url, target="_blank", rel="noopener noreferrer") #{ t('footer_source') }
