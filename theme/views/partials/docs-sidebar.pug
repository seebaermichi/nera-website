//- Language-aware docs nav. Labels come from translations; hrefs are prefixed
//- with the current language (langPrefix comes from layout.pug).
//- Each group's order mirrors pagination_order in its folder: pages/docs/*.md,
//- then pages/docs/style-guide/*.md.
-
  const docsLinks = [
    { href: langPrefix + '/docs/index.html', name: t('docs_nav_intro') },
    { href: langPrefix + '/docs/getting-started.html', name: t('docs_nav_getting_started') },
    { href: langPrefix + '/docs/core-concepts.html', name: t('docs_nav_core_concepts') },
    { href: langPrefix + '/docs/writing-content.html', name: t('docs_nav_writing_content') },
    { href: langPrefix + '/docs/plugins.html', name: t('docs_nav_plugins') },
    { href: langPrefix + '/docs/deployment.html', name: t('docs_nav_deployment') },
    { href: langPrefix + '/docs/cli.html', name: t('docs_nav_cli') },
    { href: langPrefix + '/docs/using-ai.html', name: t('docs_nav_ai') }
  ]
  const styleGuideLinks = [
    { href: langPrefix + '/docs/style-guide/index.html', name: t('docs_style_nav_principle') },
    { href: langPrefix + '/docs/style-guide/plugins.html', name: t('docs_style_nav_plugins') },
    { href: langPrefix + '/docs/style-guide/themes-and-starters.html', name: t('docs_style_nav_themes') },
    { href: langPrefix + '/docs/style-guide/tests.html', name: t('docs_style_nav_tests') },
    { href: langPrefix + '/docs/style-guide/tooling.html', name: t('docs_style_nav_tooling') }
  ]
  const groups = [
    { heading: t('docs_heading'), links: docsLinks },
    { heading: t('docs_style_heading'), links: styleGuideLinks }
  ]
nav.docs-sidebar(aria-label=t('docs_heading'))
  each group in groups
    p.docs-sidebar__heading #{ group.heading }
    ul.docs-sidebar__list
      each link in group.links
        li.docs-sidebar__item
          a.docs-sidebar__link(href=link.href, class=(link.href === meta.href ? 'docs-sidebar__link--active' : '')) #{ link.name }
