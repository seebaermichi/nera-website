extends ../layouts/layout

block content
  //- langPrefix comes from layout.pug (shared scope).
  section.hero
    .container
      .hero__inner
        p.hero__eyebrow #{ app.npm_scope } · MIT · Node ≥ 20
        h1.hero__title #{ app.name }
        p.hero__tagline #{ t('tagline') }
        .hero__actions
          a.button.button--primary(href=`${ langPrefix }/docs/index.html`) #{ t('cta_get_started') }
          a.button.button--ghost(href=`${ langPrefix }/plugins/index.html`) #{ t('cta_browse_plugins') }
        pre.hero__code
          code npx @nera-static/nera new my-site

  section.home-body
    .container
      //- Feature grid: one stack page per feature in pages/<lang>/stacks/home-features/,
      //- grouped and ordered by @nera-static/plugin-stacks (stack_group, stack_order).
      - const features = app.stackGroupsByLang?.home_features?.[curLang] || []
      if features.length
        .home-body__grid
          each feature, i in features
            .home-body__feature
              p.home-body__feature-num #{ String(i + 1).padStart(2, '0') }
              h2.home-body__feature-title #{ feature.meta.title }
              .home-body__feature-desc!= feature.content

      //- Any prose authored in the Markdown body renders below the grid.
      if content && content.trim()
        article.prose
          != content
