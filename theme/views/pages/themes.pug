extends ../layouts/layout

block content
  section.plugins.container
    header.plugins__header
      h1.plugins__title #{ meta.title }
    article.prose
      != content

    //- The catalog lives in `data/themes.yaml`; the page's `page_data: themes`
    //- has plugin-page-data load it into `meta.data.themes`, translated fields
    //- already resolved to the page's language. Falls back gracefully if absent.
    //- `demo` is optional: a theme without one renders no link.
    - const themes = (meta.data && meta.data.themes) || []
    if themes.length
      ul.theme-cards
        each theme, index in themes
          li.theme-card
            if theme.image
              img.theme-card__image(src=theme.image, alt=theme.alt || '', width="960", height="600", loading=index === 0 ? 'eager' : 'lazy', decoding="async")
            .theme-card__body
              h2.theme-card__name #{ theme.name }
              p.theme-card__desc #{ theme.audience }
              if theme.package
                code.theme-card__pkg #{ theme.package }
              if theme.starters && theme.starters.length
                ul.theme-card__starters
                  each starter in theme.starters
                    li
                      code npx @nera-static/nera new my-site --starter #{ starter }
              p.theme-card__links
                if theme.demo
                  a.theme-card__link(href=theme.demo) #{ t('theme_card_demo') } →
                if theme.readme
                  a.theme-card__link(href=theme.readme, target="_blank", rel="noopener noreferrer") #{ t('theme_card_readme') } →
