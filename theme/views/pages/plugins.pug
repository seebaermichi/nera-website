extends ../layouts/layout

block content
  section.plugins.container
    header.plugins__header
      h1.plugins__title #{ meta.title }
    article.prose
      != content

    //- The catalog lives in `data/plugins.yaml`; the page's `page_data: plugins`
    //- has plugin-page-data load it into `meta.data.plugins`, translated fields
    //- already resolved to the page's language. Falls back gracefully if absent.
    - const plugins = (meta.data && meta.data.plugins) || []
    if plugins.length
      ul.plugin-cards
        each plugin in plugins
          li.plugin-card
            h2.plugin-card__name #{ plugin.name }
            p.plugin-card__desc #{ plugin.description }
            if plugin.package
              code.plugin-card__pkg #{ plugin.package }
            if plugin.url
              a.plugin-card__link(href=plugin.url, target="_blank", rel="noopener noreferrer") Docs →
