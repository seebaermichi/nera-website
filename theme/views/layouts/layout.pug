//- Language context, declared once and shared by every partial and block
//- (Pug inlines includes/blocks into one scope, so these must not be re-declared).
- const curLang = meta.lang || app.lang
- const langPrefix = curLang === 'en' ? '' : '/' + curLang
//- Languages temporarily hidden pending review (Spanish awaits a native-speaker
//- pass). Any page in these languages — authored OR plugin-generated, e.g. tag
//- overview pages — is forced to noindex here in one place. To restore a
//- language: drop it from this list, re-add it to the switcher (site-header.pug)
//- and to available_languages (config/canonical-links.yaml).
- const hiddenLangs = ['es']
<!DOCTYPE html>
html(lang=curLang)
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{ meta.title } | #{ app.name }
    meta(name="description", content=`${ meta.description || t('app_description') }`)
    meta(name="keywords", content=`${ meta.keywords || t('app_keywords') }`)
    meta(name="generator" content=`nera - ${ process.env.npm_package_version }`)
    meta(name="robots" content=(hiddenLangs.includes(curLang) ? 'noindex,follow' : (meta.robots || app.robots)))
    // Canonical + alternate language links (plugin-canonical-links)
    include ../vendor/plugin-canonical-links/index

    //- Brand favicon / app icons. SVG first for modern browsers (it carries its
    //- own light/dark swap), PNG fallbacks, .ico for legacy, apple-touch for
    //- the iOS home screen. Served from the site root via assets/.
    link(rel="icon", href="/favicon.ico", sizes="32x32")
    link(rel="icon", type="image/svg+xml", href="/favicon.svg")
    link(rel="icon", type="image/png", sizes="32x32", href="/favicon-32.png")
    link(rel="icon", type="image/png", sizes="16x16", href="/favicon-16.png")
    link(rel="apple-touch-icon", href="/apple-touch-icon.png")
    link(rel="manifest", href="/site.webmanifest")
    meta(name="theme-color", content="#b45309")

    link(rel="stylesheet", href="/css/main.css")

  body
    include ../partials/site-header

    main.site-main
      block content

    include ../partials/site-footer
